# Copy to .env for local Docker Compose only. Never commit the populated .env file.
DB_USERNAME=user
DB_PASSWORD=replace-with-a-strong-local-database-password

# Base64-encoded random secret containing at least 32 random bytes.
# Generate locally with the PowerShell command in DEPLOYMENT_CLOUD_RUN_NEON.md.
JWT_SECRET=replace-with-generated-base64-secret

# Optional local integrations
RECAPTCHA_SECRET_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
FAST2SMS_API_KEY=
